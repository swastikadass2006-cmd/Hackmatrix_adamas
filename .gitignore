# ==========================================
# TrustLens / Hackmatrix .gitignore
# ==========================================

# 1. Dependencies & Package Managers
node_modules/
*/node_modules/
*/*/node_modules/
.pnpm-store/
.yarn/
package-lock.json.bak

# 2. Next.js & Build Outputs
.next/
*/.next/
*/*/.next/
out/
dist/
build/

# 3. TypeScript & Compiler Cache
*.tsbuildinfo
next-env.d.ts

# 4. Testing, Vitest & Coverage
.vite/
*/.vite/
coverage/
.nyc_output/

# 5. Environment & Local Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# 6. Python Engine & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/
.env/

# 7. IDE, OS & System Files
.openidea/
*/.openidea/
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db

# 8. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

