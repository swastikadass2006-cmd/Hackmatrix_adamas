# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force scripts and code to LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.sol text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
