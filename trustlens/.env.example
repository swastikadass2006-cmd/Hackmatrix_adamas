# ===========================================
# TrustLens Environment Configuration
# ===========================================

# Gateway & Service URLs
PORT=8000
HOST=0.0.0.0
SECURITY_ENGINE_URL=http://localhost:8001

# Cryptography & CA Distrust Policies
DISTRUSTED_CA_PATTERNS=emudhra,symantec,wosign,startcom

# Database Connection (SQLite default, or postgresql://user:pass@localhost:5432/trustlens)
DATABASE_URL=sqlite:///./trustlens.db

# Security & Limits
RATE_LIMIT_PER_MINUTE=60
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_SECONDS=10
