{
  "manifest_version": 3,
  "name": "TrustLens — Real-Time Phishing & Credential Guard",
  "version": "1.0.0",
  "description": "Explaining digital trust scores and warning before credential submission on phishing clones.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustLens Trust Inspector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

